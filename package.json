{
    "name": "zycord",
    "version": "1.0.0",
    "private": "true",
    "description": "Zycord Client \u2014 a Discord client. By Zynu.",
    "homepage": "https://github.com/SahilVerlice/Zycord#readme",
    "bugs": {
        "url": "https://github.com/SahilVerlice/Zycord/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": "Zynu",
    "main": "dist/js/main.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SahilVerlice/Zycord.git"
    },
    "scripts": {
        "build": "pnpm build:core && pnpm build:shell",
        "build:core": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs --standalone --disable-updater",
        "build:shell": "node scripts/build/shell.mjs",
        "buildStandalone": "pnpm build:core --standalone",
        "watch": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs --watch --dev",
        "dev": "pnpm watch",
        "start": "electron .",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/runInstaller.mjs -- --install",
        "uninject": "node scripts/runInstaller.mjs -- --uninstall",
        "lint": "oxlint",
        "fmt": "oxfmt \"**/*.{css,html,json,yml,yaml}\"",
        "fmt:check": "pnpm fmt --check",
        "lint:fix": "pnpm lint --fix",
        "test:ts": "tsc --noEmit",
        "bump": "./scripts/bump.sh",
        "dist": "pnpm build && electron-builder --win nsis --x64",
        "dist:dir": "pnpm build && electron-builder --win dir --x64",
        "build:dev": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs --dev"
    },
    "dependencies": {
        "@intrnl/xxhash64": "catalog:",
        "@vap/core": "catalog:",
        "@vap/shiki": "catalog:",
        "@vencord/monaco-editor": "catalog:",
        "fflate": "catalog:",
        "gifenc": "catalog:"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "catalog:",
        "@types/chrome": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/yazl": "catalog:",
        "@vencord/discord-types": "workspace:",
        "diff": "catalog:",
        "electron": "catalog:",
        "electron-builder": "^26.18.0",
        "esbuild": "catalog:",
        "eslint-plugin-path-alias": "catalog:",
        "eslint-plugin-simple-header": "catalog:",
        "eslint-plugin-simple-import-sort": "catalog:",
        "html-minifier-terser": "catalog:",
        "lodash": "catalog:",
        "moment": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "p-limit": "catalog:",
        "puppeteer-core": "catalog:",
        "standalone-electron-types": "catalog:",
        "svgo": "catalog:",
        "ts-patch": "catalog:",
        "ts-pattern": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "typescript-transform-paths": "catalog:",
        "zip-local": "catalog:"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.15.0",
    "build": {
        "appId": "app.zycord.client",
        "productName": "Zycord",
        "executableName": "Zycord",
        "copyright": "Copyright \u00a9 2026 Zynu. Based on Vencord by Vendicated and contributors (GPL-3.0-or-later).",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "dist/js/**/*",
            "package.json",
            "LICENSE",
            "NOTICE",
            "README.md"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Zycord-Client-Setup-${version}-${arch}.${ext}",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Zycord",
            "deleteAppDataOnUninstall": false,
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico"
        }
    }
}